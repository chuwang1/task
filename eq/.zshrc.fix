# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/Users/dengxiaoya/miniforge3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/Users/dengxiaoya/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/Users/dengxiaoya/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/Users/dengxiaoya/miniforge3/bin:$PATH"
    fi
fi
export PATH="/Users/dengxiaoya/Library/Python/3.8/bin:$PATH:/opt/homebrew/bin/"
alias tf="source ~/miniforge3/bin/activate"
alias ls="ls --color=auto"
unset __conda_setup
# <<< conda initialize <<<
code () { VSCODE_CWD="$PWD" open -n -b "com.microsoft.VSCode" --args "$@"; }
LC_CTYPE=en_US.UTF-8
LC_ALL=en_US.UTF-8
alias cmsconnect='ssh  lxplus7@login-el7.uscms.org'
alias cern='expect ~/CERN'
export LIBRARY_PATH="$LIBRARY_PATH:/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/lib"
alias vim="nvim"
export PATH=/opt/local/bin:$PATH
export MANPATH=/opt/local/man:$MANPATH

# >>> juliaup initialize >>>

